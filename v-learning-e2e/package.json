{
  "name": "v-learning-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas E2E auditables (Playwright) del plan de pruebas de V-Learning, contra frontend + backend + BD reales.",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test --grep-invert @lento",
    "test:p1": "playwright test --grep @P1 --grep-invert @lento",
    "test:lentos": "playwright test --grep @lento",
    "test:ver": "cross-env HEADED=1 playwright test --headed --grep-invert @lento",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:edge": "cross-env EDGE=1 playwright test --project=msedge --grep-invert @lento",
    "reporte": "playwright show-report",
    "auditoria:verificar": "node scripts/verificar-auditoria.js",
    "auditoria:excel": "node scripts/exportar-excel.cjs",
    "informe": "node scripts/informe.cjs",
    "video:demo": "cross-env DEMO=1 playwright test --project=demo && node scripts/video-demo.cjs",
    "video:montar": "node scripts/video-demo.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "adm-zip": "0.5.16",
    "cross-env": "7.0.3",
    "docx": "9.5.1",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "ffmpeg-static": "5.2.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.2.0": true
  }
}
